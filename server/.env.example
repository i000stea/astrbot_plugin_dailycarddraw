# ---- 服务本身 ----
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=3100
# 改端口后必须同步改三处：插件 api_base_url、Nginx 反代、updatePush.ps1 的 HealthUrl
# 每日次数按此自然日重置，务必与玩家所在时区一致
APP_TIMEZONE=Asia/Shanghai
# 单页最大条数（防止前端一次拉太多）
MAX_PAGE_SIZE=50
# 十连一次抽几张
DRAW_TEN_COUNT=10

# ---- 抽卡图片 ----
# resource 目录默认位于 server/resource，单独上传时可用 RESOURCE_DIR 覆盖绝对路径
# RESOURCE_DIR=/www/wwwroot/astrbot_plugin_dailycarddraw/server/resource
# 图片缓存目录与 TTL（秒），默认缓存 12 小时
# IMAGE_CACHE_DIR=/www/wwwroot/astrbot_plugin_dailycarddraw/server/cache/draw-images
# IMAGE_CACHE_TTL_SECONDS=43200
# 单卡尺寸：单抽宽高；十连高度不变，宽度按张数扩展
IMAGE_CARD_WIDTH=320
IMAGE_CARD_HEIGHT=480
# IMAGE_AVATAR_SIZE=220
# IMAGE_PROFESSION_SIZE=56
# IMAGE_RARITY_SIZE=72
# IMAGE_PADDING=16


# ---- MySQL（宝塔面板 → 数据库，填面板里创建的库和账号）----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=daily_carddraw
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=daily_carddraw
MYSQL_POOL_SIZE=10

# ---- 插件侧鉴权 ----
# 与 AstrBot 插件配置里的 api_token 保持一致；留空则 /api/daily-carddraw/admin/* 不鉴权
ADMIN_API_TOKEN=replace_with_a_long_random_string

# ---- 前端管理后台登录 ----
PANEL_USERNAME=admin
# 二选一：直接填明文，或填 sha256(密码) 更安全
#   生成方式：echo -n 'your_password' | sha256sum
PANEL_PASSWORD=replace_with_a_strong_password
# PANEL_PASSWORD_SHA256=
# 建议固定填一个足够长的随机串，否则每次重启后后台登录态失效
PANEL_JWT_SECRET=replace_with_a_long_random_string
PANEL_JWT_EXPIRES_IN=12h
